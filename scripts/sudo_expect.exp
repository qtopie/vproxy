#!/usr/bin/expect -f
# Helper script to run sudo commands with a password from a file
set timeout 60
set cmd [lindex $argv 0]
set pass_file [lindex $argv 1]

if {[file exists $pass_file]} {
    set fp [open $pass_file r]
    set pass [read $fp]
    close $fp
    set pass [string trim $pass]
} else {
    puts "Error: Password file $pass_file not found"
    exit 1
}

# Split the command string into a list for spawn
set cmd_list [split $cmd " "]

spawn sudo {*}$cmd_list
expect {
    "*Password:*" { send "$pass\r"; exp_continue }
    "*password for*" { send "$pass\r"; exp_continue }
    eof
}
